    def get_user_profile():
    print("\nEnter your investment details:")

    while True:
        risk = input("Risk Level (Low/Medium/High): ").capitalize()
        if risk in ["Low", "Medium", "High"]:
            break
        print("Invalid input. Try again.")

    budget = float(input("Investment Budget (₹): "))
    duration = input("Investment Duration (Short/Long): ").capitalize()

    return {
        "risk": risk,
        "budget": budget,
        "duration": duration
    }


    recommender.py

    def recommend(analysis, user):
    trend = analysis["trend"]
    risk = analysis["risk"]
    user_risk = user["risk"]

    # Decision Logic
    if trend == "Uptrend":
        if risk == user_risk:
            decision = "BUY"
        else:
            decision = "HOLD"
    else:
        decision = "AVOID"

    # Explanation
    explanation = f"""
    📊 Trend: {trend}
    ⚠️ Risk Level: {risk}

    Based on your selected risk profile ({user_risk}),
    the system suggests: {decision}

    Reason:
    - Trend analysis indicates a {trend.lower()}
    - Risk level is {risk.lower()}, compared with your preference
    """

    return decision, explanation


    visualizer.py

    import matplotlib.pyplot as plt

def plot_stock(data, ticker):
    plt.figure()
    plt.plot(data['Close'])
    plt.title(f"{ticker} Price Trend (Last 1 Month)")
    plt.xlabel("Days")
    plt.ylabel("Price")
    plt.grid()
    plt.show()


    main.py

    from data_fetcher import get_stock_data
from analyzer import analyze_stock
from recommender import recommend
from user_profile import get_user_profile
from visualizer import plot_stock

def main():
    print("📊 AI Investment Assistant (India)")

    ticker = input("\nEnter Stock Symbol (e.g., TCS.NS, INFY.NS): ").upper()

    # Fetch Data
    data = get_stock_data(ticker)
    if data is None:
        return

    # Analyze
    analysis = analyze_stock(data)

    print("\n📈 Stock Analysis:")
    print(f"Trend: {analysis['trend']}")
    print(f"Risk: {analysis['risk']}")
    print(f"Volatility: {analysis['volatility']}")

    # Plot Graph
    plot_stock(data, ticker)

    # User Input
    user = get_user_profile()

    # Recommendation
    decision, explanation = recommend(analysis, user)

    print("\n💡 FINAL RECOMMENDATION:", decision)
    print(explanation)

if __name__ == "__main__":
    main()


